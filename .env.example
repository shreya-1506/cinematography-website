# Contact form transport.
# "mock"   -> resolves locally after a short delay (default, no backend needed)
# "http"   -> POSTs JSON to VITE_CONTACT_ENDPOINT
VITE_CONTACT_TRANSPORT=mock

# Endpoint used when VITE_CONTACT_TRANSPORT=http
# Works with any service that accepts a JSON POST (Formspree, Resend proxy,
# Netlify/Vercel function, your own API, ...).
VITE_CONTACT_ENDPOINT=

# Set to "true" to make the mock transport fail, so the error state can be tested.
VITE_CONTACT_FORCE_ERROR=false
