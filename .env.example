# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# "mock"  -> resolves locally after ~1.4s and stores the payload in
#            localStorage under pp.contact.outbox. Nothing is sent anywhere.
# "http"  -> POSTs JSON to VITE_CONTACT_ENDPOINT (Formspree, a serverless
#            function, your own API — anything that accepts a JSON body).
#
# A live site MUST use "http", or enquiries are silently discarded.
VITE_CONTACT_TRANSPORT=mock
VITE_CONTACT_ENDPOINT=
# Set true to force the error state while styling it.
VITE_CONTACT_FORCE_ERROR=false

# ---------------------------------------------------------------------------
# Admin content editor  (/#/admin)
# ---------------------------------------------------------------------------
# Generate these three with:
#
#   npm run admin:credentials
#
# The password itself is never stored — only a PBKDF2-SHA-256 hash and its
# salt. Without them the editor stays locked and explains how to set them.
VITE_ADMIN_USER=
VITE_ADMIN_SALT=
VITE_ADMIN_PASSWORD_HASH=

# Set to false to leave the editor out of a production build entirely.
# Recommended for a public deploy: the sign-on runs in the visitor's browser,
# so it is a lock, not a security boundary. See "Hosting the admin safely"
# in the README.
VITE_ADMIN_ENABLED=true

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Sub-path for the build, e.g. /cinematography-website/ for a GitHub Pages
# project site. Leave unset for a root deploy. `npm run build:ghpages` sets
# this for you.
# VITE_BASE=/
